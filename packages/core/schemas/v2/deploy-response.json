{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "deployId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "building",
        "deployed",
        "failed"
      ]
    },
    "url": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": [
    "deployId",
    "status"
  ],
  "$id": "https://blkc.blackcode.space/schemas/v2/deploy-response.json"
}
