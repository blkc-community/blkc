{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "manifestVersion": {
      "default": 1,
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z0-9\\-]+$"
    },
    "name": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "license": {
      "default": "MIT",
      "type": "string"
    },
    "authors": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "github": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "repository": {
      "type": "string",
      "format": "uri"
    },
    "docs": {
      "type": "string",
      "format": "uri"
    },
    "metrics": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "unit"
        ]
      }
    },
    "visibility": {
      "default": "public",
      "type": "string",
      "enum": [
        "public",
        "private"
      ]
    },
    "changelog": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "version",
          "date",
          "summary"
        ]
      }
    },
    "kind": {
      "type": "string",
      "const": "capability"
    },
    "entryPoint": {
      "type": "string"
    },
    "runtime": {
      "default": "bun",
      "type": "string",
      "enum": [
        "bun",
        "node",
        "python",
        "docker"
      ]
    },
    "sizeMB": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "inputs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64,
            "pattern": "^[a-z0-9\\-]+$"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "description"
        ]
      }
    },
    "input": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "output": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "permissions": {
      "default": {
        "network": false,
        "secrets": []
      },
      "type": "object",
      "properties": {
        "network": {
          "default": false,
          "type": "boolean"
        },
        "secrets": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "placement": {
      "default": "server",
      "type": "string",
      "enum": [
        "server",
        "browser"
      ]
    },
    "models": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "license": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "assets": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "game": {
      "type": "object",
      "properties": {
        "xpCost": {
          "type": "number"
        },
        "unlockCondition": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "visualization": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "id",
    "name",
    "summary",
    "description",
    "version",
    "kind",
    "entryPoint"
  ],
  "$id": "https://blkc.blackcode.space/schemas/v2/capability-block.json"
}
