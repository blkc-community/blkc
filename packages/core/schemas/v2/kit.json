{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "manifestVersion": {
      "default": 1,
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z0-9\\-]+$"
    },
    "name": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "license": {
      "default": "MIT",
      "type": "string"
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "blockId": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64,
            "pattern": "^[a-z0-9\\-]+$"
          },
          "version": {
            "type": "string"
          },
          "alias": {
            "type": "string"
          },
          "required": {
            "default": true,
            "type": "boolean"
          },
          "config": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "blockId",
          "version"
        ]
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "version": {
          "default": 3,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "settings": {
          "type": "object",
          "properties": {
            "color": {
              "type": "object",
              "properties": {
                "palette": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "slug": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 64,
                        "pattern": "^[a-z0-9\\-]+$"
                      },
                      "name": {
                        "type": "string"
                      },
                      "color": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "slug",
                      "name",
                      "color"
                    ]
                  }
                },
                "gradients": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "slug": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 64,
                        "pattern": "^[a-z0-9\\-]+$"
                      },
                      "name": {
                        "type": "string"
                      },
                      "gradient": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "slug",
                      "name",
                      "gradient"
                    ]
                  }
                }
              }
            },
            "typography": {
              "type": "object",
              "properties": {
                "fontFamilies": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "slug": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 64,
                        "pattern": "^[a-z0-9\\-]+$"
                      },
                      "name": {
                        "type": "string"
                      },
                      "fontFamily": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "slug",
                      "name",
                      "fontFamily"
                    ]
                  }
                },
                "fontSizes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "slug": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 64,
                        "pattern": "^[a-z0-9\\-]+$"
                      },
                      "name": {
                        "type": "string"
                      },
                      "size": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "slug",
                      "name",
                      "size"
                    ]
                  }
                }
              }
            },
            "spacing": {
              "type": "object",
              "properties": {
                "spacingSizes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "slug": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 64,
                        "pattern": "^[a-z0-9\\-]+$"
                      },
                      "name": {
                        "type": "string"
                      },
                      "size": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "slug",
                      "name",
                      "size"
                    ]
                  }
                },
                "units": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "layout": {
              "type": "object",
              "properties": {
                "contentSize": {
                  "type": "string"
                },
                "wideSize": {
                  "type": "string"
                }
              }
            }
          }
        },
        "styles": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      }
    },
    "content": {
      "type": "object",
      "properties": {
        "pages": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string",
                "pattern": "^[a-z0-9\\-\\/]*$"
              },
              "title": {
                "type": "string"
              },
              "blocks": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "block": {
                      "type": "string"
                    },
                    "props": {
                      "default": {},
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "block"
                  ]
                }
              }
            },
            "required": [
              "slug",
              "title"
            ]
          }
        }
      }
    },
    "maintainers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "github": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "documentation": {
      "type": "string",
      "format": "uri"
    },
    "repository": {
      "type": "string",
      "format": "uri"
    },
    "pricing": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "enum": [
            "free",
            "one-time",
            "subscription",
            "usage"
          ]
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "default": "USD",
          "type": "string"
        }
      },
      "required": [
        "model"
      ]
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "visibility": {
      "default": "public",
      "type": "string",
      "enum": [
        "public",
        "private"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "summary",
    "description",
    "version",
    "category",
    "blocks"
  ],
  "$id": "https://blkc.blackcode.space/schemas/v2/kit.json"
}
