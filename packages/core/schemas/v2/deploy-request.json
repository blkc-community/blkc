{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "siteId": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "default": "development",
      "type": "string",
      "enum": [
        "development",
        "staging",
        "production"
      ]
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "projectId",
    "siteId"
  ],
  "$id": "https://blkc.blackcode.space/schemas/v2/deploy-request.json"
}
