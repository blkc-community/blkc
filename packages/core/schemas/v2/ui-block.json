{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "manifestVersion": {
      "default": 1,
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z0-9\\-]+$"
    },
    "name": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "license": {
      "default": "MIT",
      "type": "string"
    },
    "authors": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "github": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "repository": {
      "type": "string",
      "format": "uri"
    },
    "docs": {
      "type": "string",
      "format": "uri"
    },
    "metrics": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "unit"
        ]
      }
    },
    "visibility": {
      "default": "public",
      "type": "string",
      "enum": [
        "public",
        "private"
      ]
    },
    "changelog": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "version",
          "date",
          "summary"
        ]
      }
    },
    "kind": {
      "type": "string",
      "const": "ui"
    },
    "category": {
      "type": "string"
    },
    "attributes": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "boolean",
              "richtext",
              "link",
              "image",
              "color",
              "list"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "default": {},
          "minLength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maxLength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "enum": {
            "type": "array",
            "items": {}
          },
          "label": {
            "type": "string"
          },
          "help": {
            "type": "string"
          },
          "placeholder": {
            "type": "string"
          },
          "control": {
            "type": "string"
          },
          "group": {
            "type": "string",
            "enum": [
              "content",
              "style",
              "settings"
            ]
          },
          "items": {}
        },
        "required": [
          "type"
        ]
      }
    },
    "props": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "object"
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          ]
        }
      },
      "required": [
        "type",
        "properties"
      ]
    },
    "controls": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "prop": {
            "type": "string",
            "minLength": 1
          },
          "control": {
            "type": "string",
            "enum": [
              "text",
              "textarea",
              "richtext",
              "url",
              "number",
              "range",
              "toggle",
              "select",
              "color",
              "image",
              "link",
              "repeater"
            ]
          },
          "label": {
            "type": "string"
          },
          "help": {
            "type": "string"
          },
          "group": {
            "default": "content",
            "type": "string",
            "enum": [
              "content",
              "style",
              "settings"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              },
              "required": [
                "label",
                "value"
              ]
            }
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "step": {
            "type": "number"
          },
          "placeholder": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "prop": {
                  "type": "string",
                  "minLength": 1
                },
                "control": {
                  "type": "string",
                  "enum": [
                    "text",
                    "textarea",
                    "richtext",
                    "url",
                    "number",
                    "range",
                    "toggle",
                    "select",
                    "color",
                    "image",
                    "link"
                  ]
                },
                "label": {
                  "type": "string"
                },
                "help": {
                  "type": "string"
                },
                "group": {
                  "default": "content",
                  "type": "string",
                  "enum": [
                    "content",
                    "style",
                    "settings"
                  ]
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "value": {
                        "type": [
                          "string",
                          "number"
                        ]
                      }
                    },
                    "required": [
                      "label",
                      "value"
                    ]
                  }
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "step": {
                  "type": "number"
                },
                "placeholder": {
                  "type": "string"
                }
              },
              "required": [
                "prop",
                "control",
                "label"
              ]
            }
          }
        },
        "required": [
          "prop",
          "control",
          "label"
        ]
      }
    },
    "supports": {
      "type": "object",
      "properties": {
        "align": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "left",
              "center",
              "right",
              "wide",
              "full"
            ]
          }
        },
        "color": {
          "type": "object",
          "properties": {
            "text": {
              "type": "boolean"
            },
            "background": {
              "type": "boolean"
            }
          }
        },
        "spacing": {
          "type": "object",
          "properties": {
            "padding": {
              "type": "boolean"
            },
            "margin": {
              "type": "boolean"
            }
          }
        },
        "typography": {
          "type": "object",
          "properties": {
            "fontSize": {
              "type": "boolean"
            },
            "fontFamily": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "renderers": {
      "type": "object",
      "properties": {
        "web": {
          "type": "object",
          "properties": {
            "package": {
              "type": "string",
              "minLength": 1
            },
            "export": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "package",
            "export"
          ]
        },
        "native": {
          "type": "object",
          "properties": {
            "package": {
              "type": "string",
              "minLength": 1
            },
            "export": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "package",
            "export"
          ]
        },
        "tv": {
          "type": "object",
          "properties": {
            "package": {
              "type": "string",
              "minLength": 1
            },
            "export": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "package",
            "export"
          ]
        },
        "canvas": {
          "type": "object",
          "properties": {
            "package": {
              "type": "string",
              "minLength": 1
            },
            "export": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "package",
            "export"
          ]
        }
      }
    },
    "example": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "id",
    "name",
    "summary",
    "description",
    "version",
    "kind",
    "props",
    "renderers"
  ],
  "$id": "https://blkc.blackcode.space/schemas/v2/ui-block.json"
}
