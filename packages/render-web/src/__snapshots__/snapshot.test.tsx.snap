// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`hero snapshot > renders the default hero 1`] = `"<section class="blkc-hero relative flex w-full flex-col justify-center px-6 py-16 bg-background text-foreground bg-[radial-gradient(60rem_30rem_at_50%_-10%,color-mix(in_srgb,var(--blkc-color-primary,#0066cc)_16%,transparent),transparent)] text-left items-start"><div class="flex w-full max-w-3xl flex-col gap-4"><h1 class="blkc-heading font-bold leading-[1.1] tracking-tight text-balance text-4xl sm:text-5xl">Hello</h1><p class="text-muted-foreground text-pretty text-lg sm:text-xl">World</p><div class="flex flex-wrap items-center gap-3 justify-start"><a href="/go" class="inline-flex items-center justify-center gap-2 rounded-lg px-6 py-3 text-base font-semibold no-underline shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring bg-primary text-primary-foreground hover:bg-primary/90">Go</a></div></div></section>"`;
