{
  "name": "@blkc-code/agents",
  "version": "0.2.0",
  "type": "module",
  "description": "Track what agents are doing and hand them work, over MCP or from code",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@blkc-code/core": "^0.2.1",
    "@types/node": "^22.9.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "blkc",
    "agents",
    "mcp"
  ],
  "author": "Black Code Enterprises LLC",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/blkc-community/blkc.git",
    "directory": "packages/agents"
  }
}
