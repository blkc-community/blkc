{
  "name": "@blkc-code/mapgen",
  "version": "0.6.0",
  "type": "module",
  "description": "Grows a unique map from a project, and keeps it in step as the project changes",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "@blkc-code/render-canvas": "^0.7.0",
    "@types/node": "^22.9.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "blkc",
    "procedural",
    "map"
  ],
  "author": "Black Code Enterprises LLC",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/blkc-community/blkc.git",
    "directory": "packages/mapgen"
  }
}
