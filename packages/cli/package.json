{
  "name": "@blkc-code/cli",
  "version": "0.6.5",
  "type": "module",
  "description": "BLKC developer CLI tools",
  "bin": {
    "blkc": "dist/blkc.cjs"
  },
  "files": [
    "dist/blkc.cjs"
  ],
  "scripts": {
    "build": "tsc && esbuild src/cli-entry.ts --bundle --platform=node --target=node22 --format=cjs --loader:.css=text '--define:process.env.NODE_ENV=\"production\"' --metafile=dist/meta.json --outfile=dist/blkc.cjs && cp dist/blkc.cjs dist/cli.js",
    "build:watch": "tsc -w",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@blkc-code/agents": "^0.2.0",
    "@blkc-code/connect": "^0.1.1",
    "@blkc-code/core": "^0.2.1",
    "@blkc-code/logbook": "^0.1.4",
    "@blkc-code/mapgen": "^0.3.0",
    "@blkc-code/render-canvas": "^0.6.0",
    "@blkc-code/render-web": "^0.4.1",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "esbuild": "^0.24.0",
    "inquirer": "^12.0.0",
    "ora": "^8.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sucrase": "^3.35.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "blkc",
    "cli",
    "developer-tools",
    "command-line"
  ],
  "author": "Black Code Enterprises LLC",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blkc-community/blkc.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/blkc-community/blkc/issues"
  },
  "homepage": "https://blkc.community"
}
