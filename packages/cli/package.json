{
  "name": "@blkc-code/cli",
  "version": "0.1.3",
  "type": "module",
  "description": "BLKC developer CLI tools",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "blkc": "dist/cli.js"
  },
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "bin"
  ],
  "scripts": {
    "build": "tsc && cp bin/blkc.js dist/cli.js",
    "build:watch": "tsc -w",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@blkc-code/cli": "^0.1.2",
    "@blkc-code/core": "^0.1.0",
    "@blkc-code/logbook": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "inquirer": "^12.0.0",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "blkc",
    "cli",
    "developer-tools",
    "command-line"
  ],
  "author": "Black Code Enterprises LLC",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blkc-community/blkc.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/blkc-community/blkc/issues"
  },
  "homepage": "https://blkc.community"
}
